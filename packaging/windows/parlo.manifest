<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Manifiesto de aplicación de parlo.exe (ADR-0006). Lo incrusta crates/tc-app/build.rs vía winresource. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  <assemblyIdentity type="win32" name="app.parlo.Parlo" version="0.0.1.0" processorArchitecture="*"/>
  <description>Parlo</description>
  <!-- AppUserModelID (notificaciones, ADR-0013): un manifiesto Win32 no puede declararlo (solo los paquetes
       MSIX). Lo fijan el acceso directo del instalador (parlo.iss, AppUserModelID "app.parlo.Parlo") y el
       propio proceso al arrancar (tc-notify: SetCurrentProcessExplicitAppUserModelID). El zip portable no
       crea acceso directo: sin él Windows no muestra los toasts. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 y 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <asmv3:application>
    <asmv3:windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </asmv3:windowsSettings>
  </asmv3:application>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>
</assembly>
