#!/usr/bin/env xdg-open
[Desktop Entry]
Type=Application
Version=1.5
Name=Parlo
GenericName=Mensajería
GenericName[en]=Messaging
Comment=Cliente de mensajería de escritorio
Comment[en]=Desktop messaging client
Exec=parlo
Icon=parlo
Terminal=false
Categories=Network;InstantMessaging;Chat;
Keywords=chat;mensajes;messaging;
StartupNotify=true
StartupWMClass=parlo
# GNOME: lista Parlo en Ajustes > Notificaciones (tc-notify envía la pista desktop-entry=parlo).
X-GNOME-UsesNotifications=true
