  "motion": {
    "springs": {
      "rapido": {
        "stiffness": 1840,
        "damping": 77,
        "mass": 1,
        "settle_ms": 119,
        "overshoot_pct": 0.2,
        "use": "hover, press, toggles, checkbox"
      },
      "estandar": {
        "stiffness": 720,
        "damping": 47,
        "mass": 1,
        "settle_ms": 179,
        "overshoot_pct": 0.3,
        "use": "paneles, menús, entrada de burbuja, cambio de chat"
      },
      "suave": {
        "stiffness": 600,
        "damping": 45,
        "mass": 1,
        "settle_ms": 221,
        "overshoot_pct": 0.1,
        "use": "diálogos, toasts, panel de info"
      },
      "rebote": {
        "stiffness": 900,
        "damping": 43,
        "mass": 1,
        "settle_ms": 220,
        "overshoot_pct": 3.9,
        "use": "solo botón enviar, reacción añadida, badge nuevo"
      }
    },
    "easing_fallback": {
      "rapido": {
        "ms": 120,
        "bezier": [
          0.2,
          0.0,
          0.0,
          1.0
        ]
      },
      "estandar": {
        "ms": 180,
        "bezier": [
          0.2,
          0.8,
          0.2,
          1.0
        ]
      },
      "suave": {
        "ms": 220,
        "bezier": [
          0.3,
          0.0,
          0.0,
          1.0
        ]
      },
      "salida": {
        "ms": 140,
        "bezier": [
          0.4,
          0.0,
          1.0,
          1.0
        ]
      }
    },
    "exceptions": {
      "highlight_fade_ms": 900,
      "typing_dots_period_ms": 1200,
      "skeleton_pulse_period_ms": 1400
    },
    "rules": [
      "animar solo posición, escala y opacidad",
      "nunca animar layout ni tamaño de texto",
      "interrumpible: un muelle nuevo parte de la posición y velocidad actuales",
      "reducir movimiento: duración 0 salvo opacidad <= 100 ms"
    ]
  },
